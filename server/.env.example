# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
# Checked before PORT, so a supervising process that exports PORT for the
# frontend cannot hijack the API's port.
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/college_coding_app

# ---------------------------------------------------------------------------
# Auth — session JWT signing secret. MUST be changed for production.
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12

# Google OAuth 2.0 (Google Identity Services).
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=294672762802-3jf8pkhgfh8j10bvf398ris1d8fnh47o.apps.googleusercontent.com

# Optional: restrict sign-in to a single Google Workspace domain (the college's).
# Leave blank to allow any Google account.
ALLOWED_EMAIL_DOMAIN=

# Comma-separated emails auto-provisioned with elevated roles on first sign-in.
ADMIN_EMAILS=
TEACHER_EMAILS=

# Dev-only password-less login so the app is usable before Google creds exist.
# Hard-refuses to run when NODE_ENV=production.
ALLOW_DEV_LOGIN=true

# ---------------------------------------------------------------------------
# Code execution
# ---------------------------------------------------------------------------
# judge0 = real sandbox (required for production). local = DEV-ONLY fallback,
# runs code on this machine with no sandbox; refuses to start in production.
EXECUTOR=local

# Self-hosted Judge0 (docker compose) — e.g. http://localhost:2358
JUDGE0_URL=
JUDGE0_TOKEN=

# Judge0 Cloud / RapidAPI instead of self-hosting (optional)
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Concurrency. Set JUDGE0_MAX_CONCURRENT to roughly the number of Judge0 workers
# you run — anything higher only moves the queue inside Judge0. With a class of
# 500+ the queue does the work; submissions return immediately and are graded in
# the background.
JUDGE0_MAX_CONCURRENT=16
GRADING_MAX_QUEUE=5000

# Same ceiling for the dev fallback, which spawns compilers on this host rather
# than in a sandbox — so the limit is the machine's, roughly one per core.
LOCAL_MAX_CONCURRENT=4

# TCP accept queue. A whole hall opening the exam on the bell arrives as one
# burst of connects; anything past the backlog is refused by the OS before Node
# sees it. Node's default is 511.
LISTEN_BACKLOG=2048

# ---------------------------------------------------------------------------
# AI post-test review (never used for grading)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-opus-5
