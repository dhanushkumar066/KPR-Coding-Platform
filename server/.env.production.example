# ---------------------------------------------------------------------------
# Production configuration for the KPR Coding Platform.
#
# Copy to .env on the exam server and fill in. Anything marked REQUIRED is
# checked at boot — the server refuses to start without it rather than running
# in an unsafe state.
#
# When you are done:  npm run preflight
# ---------------------------------------------------------------------------

NODE_ENV=production
API_PORT=4000

# REQUIRED. The public address students reach. It is printed into every share
# link and QR code, and the session cookie is scoped to it.
#
# Must be https: the cookie is Secure, so a plain-http origin cannot hold a
# login at all — everyone would appear signed out immediately after signing in.
CLIENT_ORIGIN=https://exams.kpriet.ac.in

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/college_coding_app

# Connections per worker. Multiplied by the worker count, this is the load
# mongod actually sees. Exam queries are small and indexed, so a deep pool buys
# queueing rather than speed.
MONGO_POOL_SIZE=25

# ---------------------------------------------------------------------------
# Sessions and sign-in
# ---------------------------------------------------------------------------
# REQUIRED. At least 32 random characters. Anyone who has this can forge a
# session as any user, including an administrator. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

SESSION_TTL_HOURS=12

# REQUIRED. Google OAuth client id.
# https://console.cloud.google.com/apis/credentials
# Add CLIENT_ORIGIN to "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Strongly recommended: restrict sign-in to the college's Google Workspace
# domain, so a personal gmail address cannot even reach the sign-in step.
ALLOWED_EMAIL_DOMAIN=kpriet.ac.in

# REQUIRED to have anyone able to administer the system.
#
# These addresses become heads of department on first sign-in, and are asked
# once which department they head. Everyone else — teachers, further heads — is
# appointed from inside the app. Adding a NEW department is the only reason to
# come back and edit this.
ADMIN_EMAILS=pandiyarajan.cse@kpriet.ac.in

# Rarely needed. Heads appoint their own teaching staff by email in the app,
# which is the path that works before that person has ever signed in.
TEACHER_EMAILS=

# MUST be false. This is password-less sign-in-as-anyone.
ALLOW_DEV_LOGIN=false

# ---------------------------------------------------------------------------
# Code execution — the non-negotiable one
# ---------------------------------------------------------------------------
# MUST be judge0. "local" runs untrusted student code directly on this host
# with no sandbox; the server refuses to start with it in production.
EXECUTOR=judge0

JUDGE0_URL=http://127.0.0.1:2358
# Set this in judge0.conf too, and keep Judge0 bound to localhost. It must
# never be reachable from a student's browser.
JUDGE0_TOKEN=

# Roughly the number of Judge0 workers you run. This is the WHOLE-MACHINE
# figure — it is divided among the API workers automatically, so it is not
# multiplied by the number of cores.
JUDGE0_MAX_CONCURRENT=16

# Submissions allowed to queue before the API says "try again" rather than
# letting a backlog grow without bound.
GRADING_MAX_QUEUE=5000

# TCP accept queue. A hall opening the paper on the bell arrives as one burst;
# anything past this is refused by the OS before Node sees it.
LISTEN_BACKLOG=2048

# API workers. Leave unset for one per core (capped at 16), which is what the
# load testing was done against. Set it lower only if this box shares hardware.
# WEB_CONCURRENCY=

# ---------------------------------------------------------------------------
# AI post-test review — optional, and never used for grading
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-opus-5
